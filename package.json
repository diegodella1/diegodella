{
  "name": "diegodella",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/sync-discovery.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-site.mjs",
    "audit:theme": "node scripts/audit-theme.mjs",
    "test:migration": "node --test --test-reporter=spec tests/migration-parity.mjs",
    "test:authoring": "node scripts/test-authoring.mjs",
    "smoke:discovery": "node scripts/smoke-discovery.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "validate:editorial": "node scripts/validate-editorial.mjs"
  },
  "dependencies": {
    "astro": "7.3.2",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/markdown-satteri": "0.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "typescript": "5.9.3",
    "parse5": "8.0.0"
  }
}
