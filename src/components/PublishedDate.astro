---
import { siteData, slugFromUrl } from '../lib/site';
const site = await siteData();
const article = site.writing.find(article => article.slug === slugFromUrl(Astro.url));
if (!article) throw new Error(`Missing publication metadata: ${Astro.url}`);
const format = (date: string) => new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<p class="article-published"><span>Published</span> <time datetime={article.datePublished}>{format(article.datePublished)}</time> <span aria-hidden="true">·</span> <span>Updated</span> <time datetime={article.dateModified}>{format(article.dateModified)}</time> <span aria-hidden="true">·</span> by <a href="about.html" rel="author">{site.person.name}</a></p>
