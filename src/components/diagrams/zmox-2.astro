<svg is:raw style="width:100%;font-family:'Inter',serif;" viewBox="0 0 640 160" xmlns="http://www.w3.org/2000/svg">
          <!-- Timeline axis -->
          <line opacity="0.2" stroke="var(--ink)" stroke-width="0.8" x1="30" x2="610" y1="80" y2="80"></line>

          <!-- Phase 1 -->
          <circle cx="100" cy="80" fill="var(--ink)" opacity="0.3" r="5"></circle>
          <text fill="var(--muted)" font-size="9" text-anchor="middle" x="100" y="60">Pre-2005</text>
          <text fill="var(--ink)" font-size="10" font-weight="bold" text-anchor="middle" x="100" y="105">Editorial</text>
          <text fill="var(--muted)" font-size="8.5" text-anchor="middle" x="100" y="118">Holds all 3 pillars</text>

          <!-- Arrow -->
          <path d="M130,80 L200,80" marker-end="url(#arr)" opacity="0.4" stroke="var(--muted)" stroke-dasharray="3,2" stroke-width="0.8"></path>

          <!-- Phase 2 -->
          <circle cx="230" cy="80" fill="var(--muted)" opacity="0.5" r="5"></circle>
          <text fill="var(--muted)" font-size="9" text-anchor="middle" x="230" y="60">2005–2012</text>
          <text fill="var(--ink)" font-size="10" font-weight="bold" text-anchor="middle" x="230" y="105">Search &amp; Social</text>
          <text fill="var(--muted)" font-size="8.5" text-anchor="middle" x="230" y="118">Capture distribution</text>

          <!-- Arrow -->
          <path d="M280,80 L340,80" opacity="0.4" stroke="var(--muted)" stroke-dasharray="3,2" stroke-width="0.8"></path>

          <!-- Phase 3 -->
          <circle cx="370" cy="80" fill="var(--muted)" opacity="0.7" r="5"></circle>
          <text fill="var(--muted)" font-size="9" text-anchor="middle" x="370" y="60">2012–2019</text>
          <text fill="var(--ink)" font-size="10" font-weight="bold" text-anchor="middle" x="370" y="105">Algorithmic Feed</text>
          <text fill="var(--muted)" font-size="8.5" text-anchor="middle" x="370" y="118">Capture interpretation</text>

          <!-- Arrow -->
          <path d="M415,80 L468,80" opacity="0.5" stroke="var(--accent)" stroke-dasharray="3,2" stroke-width="0.8"></path>

          <!-- Phase 4 - AI, highlighted -->
          <circle cx="500" cy="80" fill="var(--accent)" opacity="0.8" r="7"></circle>
          <text fill="var(--accent)" font-size="9" text-anchor="middle" x="500" y="57">2020–now</text>
          <text fill="var(--accent)" font-size="10" font-weight="bold" text-anchor="middle" x="500" y="105">Generative AI</text>
          <text fill="var(--accent)" font-size="8.5" opacity="0.8" text-anchor="middle" x="500" y="118">Captures transformation</text>

          <!-- Question mark - future -->
          <circle cx="590" cy="80" fill="none" opacity="0.4" r="5" stroke="var(--accent)" stroke-dasharray="2,2" stroke-width="1"></circle>
          <text fill="var(--accent)" font-size="12" opacity="0.4" text-anchor="middle" x="590" y="84">?</text>

          <defs>
            <marker id="arr" markerHeight="6" markerWidth="6" orient="auto" refX="3" refY="3">
              <path d="M0,0 L6,3 L0,6 Z" fill="var(--muted)" opacity="0.4"></path>
            </marker>
          </defs>
          <text fill="var(--muted)" font-size="8.5" font-style="italic" text-anchor="middle" x="320" y="148">Each phase appropriates the layer above. Authority does not disappear - it reconstitutes under new management.</text>
        </svg>