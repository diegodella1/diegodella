<svg is:raw style="width:100%;font-family:'Inter',serif;" viewBox="0 0 640 200" xmlns="http://www.w3.org/2000/svg">

          <!-- LEFT: Path model -->
          <text fill="var(--muted)" font-size="11" font-style="italic" text-anchor="middle" x="160" y="22">The Path Model</text>
          <text fill="var(--muted)" font-size="8.5" opacity="0.6" text-anchor="middle" x="160" y="36">Linear. One arc. One direction.</text>
          <!-- Path line -->
          <circle cx="40" cy="110" fill="var(--ink)" opacity="0.25" r="6"></circle>
          <line opacity="0.2" stroke="var(--ink)" stroke-width="1.2" x1="46" x2="268" y1="110" y2="110"></line>
          <circle cx="275" cy="110" fill="var(--ink)" opacity="0.4" r="6"></circle>
          <!-- Nodes along path -->
          <circle cx="100" cy="110" fill="var(--muted)" opacity="0.4" r="3"></circle>
          <circle cx="155" cy="110" fill="var(--muted)" opacity="0.4" r="3"></circle>
          <circle cx="215" cy="110" fill="var(--muted)" opacity="0.4" r="3"></circle>
          <!-- Labels -->
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="40" y="128">Start</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="275" y="128">End</text>
          <!-- Users all same path -->
          <text fill="var(--muted)" font-size="8" opacity="0.5" text-anchor="middle" x="155" y="90">All users → same sequence</text>
          <!-- Divider -->
          <line opacity="0.15" stroke="var(--ink)" stroke-dasharray="3,3" stroke-width="0.5" x1="310" x2="310" y1="40" y2="175"></line>

          <!-- RIGHT: Field model -->
          <text fill="var(--accent)" font-size="11" font-style="italic" opacity="0.8" text-anchor="middle" x="480" y="22">The Field Model</text>
          <text fill="var(--muted)" font-size="8.5" opacity="0.6" text-anchor="middle" x="480" y="36">Radial. Multiple arcs. One center.</text>

          <!-- Field center (the lens) -->
          <circle cx="480" cy="110" fill="var(--accent)" opacity="0.12" r="12"></circle>
          <circle cx="480" cy="110" fill="var(--accent)" opacity="0.5" r="5"></circle>
          <text fill="var(--accent)" font-size="8" opacity="0.7" text-anchor="middle" x="480" y="130">Lens</text>

          <!-- Multiple user paths radiating -->
          <line opacity="0.4" stroke="var(--muted)" stroke-dasharray="3,2" stroke-width="0.8" x1="356" x2="472" y1="60" y2="105"></line>
          <line opacity="0.4" stroke="var(--muted)" stroke-dasharray="3,2" stroke-width="0.8" x1="356" x2="468" y1="110" y2="110"></line>
          <line opacity="0.4" stroke="var(--muted)" stroke-dasharray="3,2" stroke-width="0.8" x1="356" x2="472" y1="160" y2="115"></line>
          <line opacity="0.4" stroke="var(--muted)" stroke-dasharray="3,2" stroke-width="0.8" x1="600" x2="492" y1="60" y2="105"></line>
          <line opacity="0.4" stroke="var(--muted)" stroke-dasharray="3,2" stroke-width="0.8" x1="600" x2="492" y1="110" y2="110"></line>
          <line opacity="0.4" stroke="var(--muted)" stroke-dasharray="3,2" stroke-width="0.8" x1="600" x2="492" y1="160" y2="115"></line>

          <!-- Entry points -->
          <circle cx="356" cy="60" fill="var(--muted)" opacity="0.4" r="3"></circle>
          <circle cx="356" cy="110" fill="var(--muted)" opacity="0.4" r="3"></circle>
          <circle cx="356" cy="160" fill="var(--muted)" opacity="0.4" r="3"></circle>
          <circle cx="600" cy="60" fill="var(--muted)" opacity="0.4" r="3"></circle>
          <circle cx="600" cy="110" fill="var(--muted)" opacity="0.4" r="3"></circle>
          <circle cx="600" cy="160" fill="var(--muted)" opacity="0.4" r="3"></circle>

          <text fill="var(--muted)" font-size="7.5" opacity="0.5" text-anchor="end" x="345" y="58">Telegram</text>
          <text fill="var(--muted)" font-size="7.5" opacity="0.5" text-anchor="end" x="345" y="108">Article</text>
          <text fill="var(--muted)" font-size="7.5" opacity="0.5" text-anchor="end" x="345" y="158">Podcast</text>
          <text fill="var(--muted)" font-size="7.5" opacity="0.5" x="611" y="58">Newsletter</text>
          <text fill="var(--muted)" font-size="7.5" opacity="0.5" x="611" y="108">Video</text>
          <text fill="var(--muted)" font-size="7.5" opacity="0.5" x="611" y="158">Push</text>

          <text fill="var(--muted)" font-size="8.5" font-style="italic" text-anchor="middle" x="320" y="190">In the field model, each surface is a different angle of incidence into the same gravitational center.</text>
        </svg>