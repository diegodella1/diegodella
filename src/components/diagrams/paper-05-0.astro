<svg is:raw class="hero-svg" viewBox="0 0 160 200" xmlns="http://www.w3.org/2000/svg">
        <style is:inline>
          @keyframes static-noise{0%{opacity:0.15}25%{opacity:0.4}50%{opacity:0.1}75%{opacity:0.35}100%{opacity:0.15}}
          @keyframes signal-rise{from{transform:translateY(10px);opacity:0}to{transform:translateY(0);opacity:1}}
          @keyframes beacon{0%,100%{opacity:1}50%{opacity:0.3}}
        </style>
        <!-- Noise lines -->
        <line stroke="var(--rule)" stroke-width="0.7" style="animation:static-noise 1.5s ease-in-out infinite" x1="10" x2="150" y1="45" y2="45"></line>
        <line stroke="var(--rule)" stroke-width="0.7" style="animation:static-noise 1.5s 0.2s ease-in-out infinite" x1="10" x2="150" y1="60" y2="60"></line>
        <line stroke="var(--rule)" stroke-width="0.7" style="animation:static-noise 1.5s 0.4s ease-in-out infinite" x1="10" x2="150" y1="75" y2="75"></line>
        <line stroke="var(--rule)" stroke-width="0.7" style="animation:static-noise 1.5s 0.6s ease-in-out infinite" x1="10" x2="150" y1="90" y2="90"></line>
        <line stroke="var(--rule)" stroke-width="0.7" style="animation:static-noise 1.5s 0.8s ease-in-out infinite" x1="10" x2="150" y1="105" y2="105"></line>
        <line stroke="var(--rule)" stroke-width="0.7" style="animation:static-noise 1.5s 1s ease-in-out infinite" x1="10" x2="150" y1="120" y2="120"></line>
        <line stroke="var(--rule)" stroke-width="0.7" style="animation:static-noise 1.5s 1.2s ease-in-out infinite" x1="10" x2="150" y1="135" y2="135"></line>
        <!-- Signal cutting through -->
        <path d="M30 150 L50 130 L60 140 L80 80 L100 90 L120 50 L140 30" fill="none" opacity="0" stroke="var(--accent)" stroke-width="2.5" style="animation:signal-rise 1.5s 0.8s ease-out forwards"></path>
        <!-- Beacon dot at peak -->
        <circle cx="140" cy="30" fill="var(--accent)" opacity="0" r="4" style="animation:beacon 2s 2s ease-in-out infinite, signal-rise 0.5s 2s forwards"></circle>
        <!-- Labels -->
        <text fill="var(--rule)" font-family="monospace" font-size="6" letter-spacing="1" x="25" y="175">NOISE</text>
        <text fill="var(--accent)" font-family="monospace" font-size="6" letter-spacing="1" x="105" y="175">SIGNAL</text>
        <text fill="var(--accent)" font-family="monospace" font-size="6" letter-spacing="2" opacity="0" style="animation:signal-rise 0.5s 2.3s forwards" text-anchor="middle" x="80" y="192">LAUNCH</text>
      </svg>