<svg is:raw class="hero-svg" viewBox="0 0 160 200" xmlns="http://www.w3.org/2000/svg">
        <style is:inline>
          @keyframes scale-ring{from{r:8;opacity:1}to{r:55;opacity:0}}
          @keyframes fade-in{from{opacity:0}to{opacity:1}}
          @keyframes grow-branch{from{stroke-dashoffset:60}to{stroke-dashoffset:0}}
        </style>
        <!-- Expanding rings (scale signal) -->
        <circle cx="80" cy="95" fill="none" opacity="0.6" r="8" stroke="var(--accent)" stroke-width="1" style="animation:scale-ring 3s ease-out infinite"></circle>
        <circle cx="80" cy="95" fill="none" opacity="0.6" r="8" stroke="var(--accent)" stroke-width="1" style="animation:scale-ring 3s 1s ease-out infinite"></circle>
        <circle cx="80" cy="95" fill="none" opacity="0.6" r="8" stroke="var(--accent)" stroke-width="1" style="animation:scale-ring 3s 2s ease-out infinite"></circle>
        <!-- Center core -->
        <circle cx="80" cy="95" fill="var(--accent)" r="8"></circle>
        <!-- Branch lines -->
        <line stroke="var(--accent)" stroke-dasharray="60" stroke-width="1.5" style="animation:grow-branch 1s 0.5s ease-out forwards" x1="80" x2="80" y1="87" y2="40"></line>
        <line stroke="var(--accent)" stroke-dasharray="60" stroke-width="1.5" style="animation:grow-branch 1s 0.8s ease-out forwards" x1="88" x2="135" y1="95" y2="70"></line>
        <line stroke="var(--accent)" stroke-dasharray="60" stroke-width="1.5" style="animation:grow-branch 1s 1.1s ease-out forwards" x1="88" x2="135" y1="95" y2="120"></line>
        <line stroke="var(--muted)" stroke-dasharray="3 2" stroke-width="1" style="animation:grow-branch 1s 1.4s ease-out forwards" x1="72" x2="25" y1="95" y2="70"></line>
        <line stroke="var(--muted)" stroke-dasharray="3 2" stroke-width="1" style="animation:grow-branch 1s 1.7s ease-out forwards" x1="72" x2="25" y1="95" y2="120"></line>
        <line stroke="var(--muted)" stroke-dasharray="3 2" stroke-width="1" style="animation:grow-branch 1s 2s ease-out forwards" x1="80" x2="80" y1="103" y2="150"></line>
        <!-- Endpoint dots -->
        <circle cx="80" cy="40" fill="var(--accent)" opacity="0" r="3" style="animation:fade-in 0.3s 1.5s forwards"></circle>
        <circle cx="135" cy="70" fill="var(--accent)" opacity="0" r="3" style="animation:fade-in 0.3s 1.8s forwards"></circle>
        <circle cx="135" cy="120" fill="var(--accent)" opacity="0" r="3" style="animation:fade-in 0.3s 2.1s forwards"></circle>
        <!-- Label -->
        <text fill="var(--accent)" font-family="monospace" font-size="6" letter-spacing="2" opacity="0" style="animation:fade-in 0.5s 2.5s forwards" text-anchor="middle" x="80" y="185">SCALE</text>
      </svg>