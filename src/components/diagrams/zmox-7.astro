<svg is:raw style="width:100%;font-family:'Inter',serif;" viewBox="0 0 640 380" xmlns="http://www.w3.org/2000/svg">

          <!-- Header -->
          <text fill="var(--muted)" font-size="10" font-style="italic" opacity="0.7" text-anchor="middle" x="320" y="18">Business Canvas rearticulated as Constitutive Arc functions</text>

          <!-- Block styles: rect, label, narrative label -->
          <!-- Key Partners -->
          <rect fill="var(--highlight)" height="140" opacity="0.7" stroke="var(--ink)" stroke-width="0.5" width="120" x="10" y="30"></rect>
          <text fill="var(--muted)" font-size="8.5" font-style="italic" text-anchor="middle" x="70" y="50">Key Partners</text>
          <line opacity="0.2" stroke="var(--ink)" stroke-width="0.3" x1="20" x2="120" y1="56" y2="56"></line>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="middle" x="70" y="72">Threshold</text>
          <text fill="var(--muted)" font-size="8" font-style="italic" text-anchor="middle" x="70" y="84">Keepers</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="70" y="105">Those who extend the</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="70" y="116">field's reach without</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="70" y="127">diluting the lens.</text>
          <text fill="var(--accent)" font-size="7" font-style="italic" opacity="0.6" text-anchor="middle" x="70" y="143">Arc role: Herald</text>

          <!-- Key Activities -->
          <rect fill="var(--highlight)" height="70" opacity="0.7" stroke="var(--ink)" stroke-width="0.5" width="120" x="135" y="30"></rect>
          <text fill="var(--muted)" font-size="8.5" font-style="italic" text-anchor="middle" x="195" y="50">Key Activities</text>
          <line opacity="0.2" stroke="var(--ink)" stroke-width="0.3" x1="145" x2="245" y1="56" y2="56"></line>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="middle" x="195" y="72">Field Design</text>
          <text fill="var(--accent)" font-size="7" font-style="italic" opacity="0.6" text-anchor="middle" x="195" y="84">Arc role: The Road of Trials</text>

          <!-- Key Resources -->
          <rect fill="var(--highlight)" height="65" opacity="0.7" stroke="var(--ink)" stroke-width="0.5" width="120" x="135" y="105"></rect>
          <text fill="var(--muted)" font-size="8.5" font-style="italic" text-anchor="middle" x="195" y="122">Key Resources</text>
          <line opacity="0.2" stroke="var(--ink)" stroke-width="0.3" x1="145" x2="245" y1="128" y2="128"></line>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="middle" x="195" y="144">The Lens</text>
          <text fill="var(--accent)" font-size="7" font-style="italic" opacity="0.6" text-anchor="middle" x="195" y="156">Arc role: The Mentor's Gift</text>

          <!-- Value Proposition - center, highlighted -->
          <rect fill="var(--accent-light)" height="140" opacity="0.8" stroke="var(--accent)" stroke-width="1.2" width="120" x="260" y="30"></rect>
          <text fill="var(--accent)" font-size="8.5" font-style="italic" opacity="0.7" text-anchor="middle" x="320" y="50">Value Proposition</text>
          <line opacity="0.3" stroke="var(--accent)" stroke-width="0.5" x1="270" x2="370" y1="56" y2="56"></line>
          <text fill="var(--accent)" font-size="10" font-weight="bold" text-anchor="middle" x="320" y="74">The</text>
          <text fill="var(--accent)" font-size="10" font-weight="bold" text-anchor="middle" x="320" y="88">Transformation</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="320" y="108">Not what you publish.</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="320" y="119">What the user</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="320" y="130">becomes.</text>
          <text fill="var(--accent)" font-size="7" font-style="italic" text-anchor="middle" x="320" y="150">Arc role: The Elixir</text>

          <!-- Customer Relationships -->
          <rect fill="var(--highlight)" height="70" opacity="0.7" stroke="var(--ink)" stroke-width="0.5" width="120" x="385" y="30"></rect>
          <text fill="var(--muted)" font-size="8.5" font-style="italic" text-anchor="middle" x="445" y="48">Relationships</text>
          <line opacity="0.2" stroke="var(--ink)" stroke-width="0.3" x1="395" x2="495" y1="54" y2="54"></line>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="middle" x="445" y="70">Companionship</text>
          <text fill="var(--accent)" font-size="7" font-style="italic" opacity="0.6" text-anchor="middle" x="445" y="82">Arc role: The Ally</text>

          <!-- Channels -->
          <rect fill="var(--highlight)" height="65" opacity="0.7" stroke="var(--ink)" stroke-width="0.5" width="120" x="385" y="105"></rect>
          <text fill="var(--muted)" font-size="8.5" font-style="italic" text-anchor="middle" x="445" y="122">Channels</text>
          <line opacity="0.2" stroke="var(--ink)" stroke-width="0.3" x1="395" x2="495" y1="128" y2="128"></line>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="middle" x="445" y="144">Surfaces</text>
          <text fill="var(--accent)" font-size="7" font-style="italic" opacity="0.6" text-anchor="middle" x="445" y="156">Arc role: Thresholds</text>

          <!-- Customer Segments -->
          <rect fill="var(--highlight)" height="140" opacity="0.7" stroke="var(--ink)" stroke-width="0.5" width="120" x="510" y="30"></rect>
          <text fill="var(--muted)" font-size="8.5" font-style="italic" text-anchor="middle" x="570" y="50">Customer Segments</text>
          <line opacity="0.2" stroke="var(--ink)" stroke-width="0.3" x1="520" x2="620" y1="56" y2="56"></line>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="middle" x="570" y="72">Arc Stages</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="570" y="105">Segmented not by</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="570" y="116">demographics but by</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="570" y="127">where they are in</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="570" y="138">their journey.</text>
          <text fill="var(--accent)" font-size="7" font-style="italic" opacity="0.6" text-anchor="middle" x="570" y="155">Arc role: The Hero</text>

          <!-- Cost Structure -->
          <rect fill="var(--highlight)" height="65" opacity="0.6" stroke="var(--ink)" stroke-width="0.5" width="300" x="10" y="180"></rect>
          <text fill="var(--muted)" font-size="8.5" font-style="italic" text-anchor="middle" x="160" y="200">Cost Structure</text>
          <line opacity="0.2" stroke="var(--ink)" stroke-width="0.3" x1="20" x2="300" y1="206" y2="206"></line>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="middle" x="160" y="222">The Price of Transformation</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="160" y="234">What it costs to maintain a coherent field across surfaces and time.</text>

          <!-- Revenue Streams -->
          <rect fill="var(--highlight)" height="65" opacity="0.6" stroke="var(--ink)" stroke-width="0.5" width="310" x="320" y="180"></rect>
          <text fill="var(--muted)" font-size="8.5" font-style="italic" text-anchor="middle" x="475" y="200">Revenue Streams</text>
          <line opacity="0.2" stroke="var(--ink)" stroke-width="0.3" x1="330" x2="620" y1="206" y2="206"></line>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="middle" x="475" y="222">The Return with Elixir - Monetized</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="475" y="234">Value captured from users who completed enough of the arc to pay for access to more.</text>

          <!-- Caption -->
          <text fill="var(--muted)" font-size="8.5" font-style="italic" text-anchor="middle" x="320" y="265">Each Canvas block has a narrative function. If it does not serve the arc, it works against the field.</text>
          <text fill="var(--accent)" font-size="8.5" font-style="italic" opacity="0.6" text-anchor="middle" x="320" y="278">The Value Proposition is the only block that should be defined by transformation, not output.</text>
        </svg>