<svg is:raw style="width:100%;font-family:'Inter',serif;" viewBox="0 0 640 200" xmlns="http://www.w3.org/2000/svg">

          <text fill="var(--muted)" font-size="10" font-style="italic" opacity="0.7" text-anchor="middle" x="320" y="18">The ethics axis of the Constitutive Arc</text>

          <!-- Horizontal axis: declared ← → undeclared -->
          <line opacity="0.2" stroke="var(--ink)" stroke-width="0.8" x1="50" x2="590" y1="90" y2="90"></line>

          <!-- Left pole: declared -->
          <circle cx="50" cy="90" fill="var(--ink)" opacity="0.4" r="5"></circle>
          <text fill="var(--ink)" font-size="10" font-weight="bold" text-anchor="middle" x="50" y="75">Declared</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="50" y="108">Lens visible.</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="50" y="119">Exit clear.</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="50" y="130">User can</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="50" y="141">push back.</text>

          <!-- Right pole: undeclared -->
          <circle cx="590" cy="90" fill="var(--accent)" opacity="0.7" r="5"></circle>
          <text fill="var(--accent)" font-size="10" font-weight="bold" text-anchor="middle" x="590" y="75">Undeclared</text>
          <text fill="var(--accent)" font-size="8" opacity="0.7" text-anchor="middle" x="590" y="108">Lens hidden.</text>
          <text fill="var(--accent)" font-size="8" opacity="0.7" text-anchor="middle" x="590" y="119">Exit costly.</text>
          <text fill="var(--accent)" font-size="8" opacity="0.7" text-anchor="middle" x="590" y="130">User doesn't</text>
          <text fill="var(--accent)" font-size="8" opacity="0.7" text-anchor="middle" x="590" y="141">know they're in it.</text>

          <!-- Vertical axis: shallow ↕ deep -->
          <line opacity="0.15" stroke="var(--ink)" stroke-dasharray="2,3" stroke-width="0.5" x1="320" x2="320" y1="20" y2="175"></line>
          <text fill="var(--muted)" font-size="8" opacity="0.5" text-anchor="middle" x="320" y="14">Deep transformation</text>
          <text fill="var(--muted)" font-size="8" opacity="0.5" text-anchor="middle" x="320" y="185">Shallow transformation</text>

          <!-- Four quadrants labeled -->
          <text fill="var(--ink)" font-size="9" font-style="italic" opacity="0.6" text-anchor="middle" x="170" y="50">Education</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="170" y="62">Deep + Declared</text>

          <text fill="var(--accent)" font-size="9" font-style="italic" opacity="0.7" text-anchor="middle" x="470" y="50">Propaganda</text>
          <text fill="var(--accent)" font-size="7.5" opacity="0.5" text-anchor="middle" x="470" y="62">Deep + Undeclared</text>

          <text fill="var(--ink)" font-size="9" font-style="italic" opacity="0.4" text-anchor="middle" x="170" y="160">Entertainment</text>
          <text fill="var(--muted)" font-size="7.5" opacity="0.5" text-anchor="middle" x="170" y="172">Shallow + Declared</text>

          <text fill="var(--muted)" font-size="9" font-style="italic" text-anchor="middle" x="470" y="160">Noise</text>
          <text fill="var(--muted)" font-size="7.5" opacity="0.5" text-anchor="middle" x="470" y="172">Shallow + Undeclared</text>

          <!-- Target zone marker -->
          <circle cx="160" cy="55" fill="none" opacity="0.2" r="18" stroke="var(--ink)" stroke-dasharray="2,2" stroke-width="0.8"></circle>
          <text fill="var(--ink)" font-size="7" opacity="0.4" text-anchor="middle" x="160" y="33">CAX target zone</text>

        </svg>