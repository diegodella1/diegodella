<svg is:raw class="hero-svg" viewBox="0 0 160 200" xmlns="http://www.w3.org/2000/svg">
      <style is:inline>
        @keyframes obBarSlide{from{transform:translateY(-20px);opacity:0}to{transform:translateY(0);opacity:1}}
        @keyframes obSignal{from{stroke-dashoffset:140}to{stroke-dashoffset:0}}
        @keyframes obFade{from{opacity:0}to{opacity:1}}
        @keyframes obGlow{0%,100%{opacity:0.4}50%{opacity:1}}
      </style>
      <!-- Signal lines trying to reach the right side -->
      <line opacity="0.3" stroke="var(--rule)" stroke-dasharray="2 3" stroke-width="0.5" x1="10" x2="150" y1="45" y2="45"></line>
      <line opacity="0.3" stroke="var(--rule)" stroke-dasharray="2 3" stroke-width="0.5" x1="10" x2="150" y1="80" y2="80"></line>
      <line opacity="0.3" stroke="var(--rule)" stroke-dasharray="2 3" stroke-width="0.5" x1="10" x2="150" y1="115" y2="115"></line>
      <line opacity="0.3" stroke="var(--rule)" stroke-dasharray="2 3" stroke-width="0.5" x1="10" x2="150" y1="150" y2="150"></line>
      <!-- Occluding vertical bars -->
      <rect fill="var(--ink)" height="160" opacity="0" rx="1" style="animation:obBarSlide 0.6s 0.3s ease-out forwards" width="6" x="45" y="25"></rect>
      <rect fill="var(--ink)" height="160" opacity="0" rx="1" style="animation:obBarSlide 0.6s 0.6s ease-out forwards" width="8" x="72" y="25"></rect>
      <rect fill="var(--ink)" height="160" opacity="0" rx="1" style="animation:obBarSlide 0.6s 0.9s ease-out forwards" width="10" x="100" y="25"></rect>
      <rect fill="var(--ink)" height="160" opacity="0" rx="1" style="animation:obBarSlide 0.6s 1.2s ease-out forwards" width="5" x="125" y="25"></rect>
      <!-- One signal breaking through -->
      <line stroke="var(--accent)" stroke-dasharray="140" stroke-dashoffset="140" stroke-width="1.5" style="animation:obSignal 2s 1.5s ease-out forwards" x1="10" x2="150" y1="115" y2="115"></line>
      <circle cx="150" cy="115" fill="var(--accent)" opacity="0" r="3" style="animation:obFade 0.4s 2.8s forwards"></circle>
      <!-- Eye/audience on the right -->
      <ellipse cx="150" cy="115" fill="none" opacity="0" rx="6" ry="4" stroke="var(--accent)" stroke-width="0.8" style="animation:obFade 0.5s 3s forwards"></ellipse>
      <circle cx="150" cy="115" fill="var(--accent)" opacity="0" r="1.5" style="animation:obFade 0.5s 3s forwards"></circle>
      <!-- Source dots on left -->
      <circle cx="10" cy="45" fill="var(--muted)" opacity="0" r="2" style="animation:obFade 0.3s 0.2s forwards"></circle>
      <circle cx="10" cy="80" fill="var(--muted)" opacity="0" r="2" style="animation:obFade 0.3s 0.4s forwards"></circle>
      <circle cx="10" cy="115" fill="var(--accent)" r="2.5" style="animation:obGlow 2s 1.5s ease-in-out infinite"></circle>
      <circle cx="10" cy="150" fill="var(--muted)" opacity="0" r="2" style="animation:obFade 0.3s 0.6s forwards"></circle>
      <!-- Labels -->
      <text fill="var(--muted)" font-family="monospace" font-size="6" letter-spacing="1.5" opacity="0" style="animation:obFade 0.5s 2s forwards" x="10" y="20">SIGNAL</text>
      <text fill="var(--accent)" font-family="monospace" font-size="6" letter-spacing="1.5" opacity="0" style="animation:obFade 0.5s 2.5s forwards" x="120" y="20">REACH</text>
      <text fill="var(--muted)" font-family="monospace" font-size="6" letter-spacing="2" opacity="0" style="animation:obFade 0.5s 3.2s forwards" text-anchor="middle" x="80" y="195">OCCLUSION</text>
    </svg>