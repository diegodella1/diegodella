<svg is:raw class="hero-svg" viewBox="0 0 160 200" xmlns="http://www.w3.org/2000/svg">
        <style is:inline>
          @keyframes ogPull{from{stroke-dashoffset:60}to{stroke-dashoffset:0}}
          @keyframes ogGlow{0%,100%{r:5;opacity:0.8}50%{r:8;opacity:1}}
          @keyframes ogOrbit{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
          @keyframes ogAppear{from{opacity:0}to{opacity:1}}
        </style>
        <!-- Gravitational field lines (concentric) -->
        <circle cx="80" cy="100" fill="none" opacity="0" r="55" stroke="var(--rule)" stroke-dasharray="2 4" stroke-width="0.4" style="animation:ogAppear 0.5s 0.3s forwards"></circle>
        <circle cx="80" cy="100" fill="none" opacity="0" r="40" stroke="var(--rule)" stroke-dasharray="2 3" stroke-width="0.5" style="animation:ogAppear 0.5s 0.5s forwards"></circle>
        <circle cx="80" cy="100" fill="none" opacity="0" r="25" stroke="var(--rule)" stroke-dasharray="1 2" stroke-width="0.6" style="animation:ogAppear 0.5s 0.7s forwards"></circle>
        <!-- Pull lines converging to center -->
        <line opacity="0.6" stroke="var(--accent)" stroke-dasharray="60" stroke-dashoffset="60" stroke-width="0.6" style="animation:ogPull 1.5s 1s forwards" x1="30" x2="72" y1="55" y2="95"></line>
        <line opacity="0.6" stroke="var(--accent)" stroke-dasharray="60" stroke-dashoffset="60" stroke-width="0.6" style="animation:ogPull 1.5s 1.2s forwards" x1="130" x2="88" y1="55" y2="95"></line>
        <line opacity="0.6" stroke="var(--accent)" stroke-dasharray="60" stroke-dashoffset="60" stroke-width="0.6" style="animation:ogPull 1.5s 1.4s forwards" x1="30" x2="72" y1="145" y2="105"></line>
        <line opacity="0.6" stroke="var(--accent)" stroke-dasharray="60" stroke-dashoffset="60" stroke-width="0.6" style="animation:ogPull 1.5s 1.6s forwards" x1="130" x2="88" y1="145" y2="105"></line>
        <line opacity="0.6" stroke="var(--accent)" stroke-dasharray="60" stroke-dashoffset="60" stroke-width="0.6" style="animation:ogPull 1.5s 1.8s forwards" x1="80" x2="80" y1="35" y2="92"></line>
        <line opacity="0.6" stroke="var(--accent)" stroke-dasharray="60" stroke-dashoffset="60" stroke-width="0.6" style="animation:ogPull 1.5s 2s forwards" x1="80" x2="80" y1="165" y2="108"></line>
        <!-- Orbiting particles -->
        <circle cx="30" cy="55" fill="var(--muted)" opacity="0" r="2.5" style="animation:ogAppear 0.3s 0.8s forwards"></circle>
        <circle cx="130" cy="55" fill="var(--muted)" opacity="0" r="2.5" style="animation:ogAppear 0.3s 1s forwards"></circle>
        <circle cx="30" cy="145" fill="var(--muted)" opacity="0" r="2.5" style="animation:ogAppear 0.3s 1.2s forwards"></circle>
        <circle cx="130" cy="145" fill="var(--muted)" opacity="0" r="2.5" style="animation:ogAppear 0.3s 1.4s forwards"></circle>
        <circle cx="80" cy="35" fill="var(--muted)" opacity="0" r="2.5" style="animation:ogAppear 0.3s 1.6s forwards"></circle>
        <circle cx="80" cy="165" fill="var(--muted)" opacity="0" r="2.5" style="animation:ogAppear 0.3s 1.8s forwards"></circle>
        <!-- Central origin point (glowing) -->
        <circle cx="80" cy="100" fill="var(--accent)" r="5" style="animation:ogGlow 3s 2.2s ease-in-out infinite"></circle>
        <circle cx="80" cy="100" fill="var(--paper, #FAFBFC)" r="2"></circle>
        <!-- Labels -->
        <text fill="var(--muted)" font-family="monospace" font-size="6" letter-spacing="2" opacity="0" style="animation:ogAppear 0.5s 2.5s forwards" text-anchor="middle" x="80" y="185">ORIGIN</text>
        <text fill="var(--rule)" font-family="monospace" font-size="5" letter-spacing="1.5" opacity="0" style="animation:ogAppear 0.5s 2.8s forwards" text-anchor="middle" x="80" y="195">the pull that remains</text>
      </svg>