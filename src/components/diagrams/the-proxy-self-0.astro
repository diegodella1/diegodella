<svg is:raw class="hero-svg" viewBox="0 0 160 200" xmlns="http://www.w3.org/2000/svg">
        <style is:inline>
          @keyframes psDrift{0%{transform:translateX(0)}100%{transform:translateX(6px)}}
          @keyframes psAppear{from{opacity:0}to{opacity:1}}
          @keyframes psPulse{0%,100%{opacity:0.3}50%{opacity:0.6}}
        </style>
        <!-- Center dividing line -->
        <line stroke="var(--rule)" stroke-dasharray="2 4" stroke-width="0.5" x1="80" x2="80" y1="30" y2="170"></line>
        <!-- Solid figure (the person) -->
        <g opacity="0" style="animation:psAppear 0.8s 0.3s forwards">
          <circle cx="60" cy="60" fill="none" r="12" stroke="var(--ink)" stroke-width="1.5"></circle>
          <line stroke="var(--ink)" stroke-width="1.5" x1="60" x2="60" y1="72" y2="110"></line>
          <line stroke="var(--ink)" stroke-width="1.2" x1="60" x2="45" y1="85" y2="95"></line>
          <line stroke="var(--ink)" stroke-width="1.2" x1="60" x2="75" y1="85" y2="95"></line>
          <line stroke="var(--ink)" stroke-width="1.2" x1="60" x2="48" y1="110" y2="135"></line>
          <line stroke="var(--ink)" stroke-width="1.2" x1="60" x2="72" y1="110" y2="135"></line>
        </g>
        <!-- Ghost figure (the proxy) — drifts slightly -->
        <g opacity="0" style="animation:psAppear 0.8s 0.8s forwards, psDrift 4s 1.5s ease-in-out infinite alternate">
          <circle cx="100" cy="60" fill="none" r="12" stroke="var(--accent)" stroke-dasharray="3 2" stroke-width="1.2"></circle>
          <line stroke="var(--accent)" stroke-dasharray="3 2" stroke-width="1.2" x1="100" x2="100" y1="72" y2="110"></line>
          <line stroke="var(--accent)" stroke-dasharray="3 2" stroke-width="1" x1="100" x2="85" y1="85" y2="95"></line>
          <line stroke="var(--accent)" stroke-dasharray="3 2" stroke-width="1" x1="100" x2="115" y1="85" y2="95"></line>
          <line stroke="var(--accent)" stroke-dasharray="3 2" stroke-width="1" x1="100" x2="88" y1="110" y2="135"></line>
          <line stroke="var(--accent)" stroke-dasharray="3 2" stroke-width="1" x1="100" x2="112" y1="110" y2="135"></line>
        </g>
        <!-- Connection line between them -->
        <line stroke="var(--rule)" stroke-dasharray="1 2" stroke-width="0.8" style="animation:psPulse 2s ease-in-out infinite" x1="72" x2="88" y1="60" y2="60"></line>
        <!-- Labels -->
        <text fill="var(--ink)" font-family="monospace" font-size="5" letter-spacing="1" opacity="0" style="animation:psAppear 0.5s 1.5s forwards" text-anchor="middle" x="60" y="155">PERSON</text>
        <text fill="var(--accent)" font-family="monospace" font-size="5" letter-spacing="1" opacity="0" style="animation:psAppear 0.5s 1.8s forwards" text-anchor="middle" x="100" y="155">PROXY</text>
        <text fill="var(--muted)" font-family="monospace" font-size="6" letter-spacing="2" opacity="0" style="animation:psAppear 0.5s 2.2s forwards" text-anchor="middle" x="80" y="185">SEVERED</text>
        <text fill="var(--rule)" font-family="monospace" font-size="5" letter-spacing="1.5" opacity="0" style="animation:psAppear 0.5s 2.5s forwards" text-anchor="middle" x="80" y="195">same name, two selves</text>
      </svg>