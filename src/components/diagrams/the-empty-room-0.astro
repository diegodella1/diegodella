<svg is:raw class="hero-svg" viewBox="0 0 160 200" xmlns="http://www.w3.org/2000/svg">
        <style is:inline>
          @keyframes erFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
          @keyframes erFade{0%{opacity:0.7}100%{opacity:0}}
          @keyframes erPulse{0%,100%{opacity:0.3}50%{opacity:0.7}}
          @keyframes erAppear{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
        </style>
        <!-- Room outline -->
        <rect fill="none" height="120" rx="2" stroke="var(--rule)" stroke-dasharray="4 3" stroke-width="0.8" width="120" x="20" y="40"></rect>
        <!-- Floor line -->
        <line stroke="var(--ink)" stroke-width="1" x1="20" x2="140" y1="160" y2="160"></line>
        <!-- Empty chair -->
        <rect fill="none" height="5" opacity="0" rx="1" stroke="var(--ink)" stroke-width="1.2" style="animation:erAppear 0.6s 0.3s forwards" width="40" x="60" y="110"></rect>
        <line opacity="0" stroke="var(--ink)" stroke-width="1" style="animation:erAppear 0.6s 0.4s forwards" x1="63" x2="63" y1="115" y2="140"></line>
        <line opacity="0" stroke="var(--ink)" stroke-width="1" style="animation:erAppear 0.6s 0.4s forwards" x1="97" x2="97" y1="115" y2="140"></line>
        <rect fill="none" height="25" opacity="0" rx="1" stroke="var(--ink)" stroke-width="1" style="animation:erAppear 0.6s 0.5s forwards" width="4" x="58" y="90"></rect>
        <!-- Floating metrics dissolving -->
        <g style="animation:erFloat 3s ease-in-out infinite">
          <text fill="var(--accent)" font-family="monospace" font-size="7" style="animation:erFade 4s 1s forwards" x="35" y="65">+2.4k</text>
        </g>
        <g style="animation:erFloat 3.5s ease-in-out infinite 0.5s">
          <text fill="var(--muted)" font-family="monospace" font-size="6" style="animation:erFade 3.5s 1.5s forwards" x="100" y="55">98%</text>
        </g>
        <g style="animation:erFloat 2.8s ease-in-out infinite 1s">
          <text fill="var(--rule)" font-family="monospace" font-size="5" style="animation:erFade 3s 2s forwards" x="50" y="80">▲ 12.1</text>
        </g>
        <g style="animation:erFloat 3.2s ease-in-out infinite 0.3s">
          <text fill="var(--muted)" font-family="monospace" font-size="5.5" style="animation:erFade 4.5s 1.2s forwards" x="105" y="75">♥ 841</text>
        </g>
        <!-- Cursor blinking alone -->
        <rect fill="var(--accent)" height="8" style="animation:erPulse 1.5s ease-in-out infinite" width="4" x="78" y="130"></rect>
        <!-- Label -->
        <text fill="var(--muted)" font-family="monospace" font-size="6" letter-spacing="2" opacity="0" style="animation:erAppear 0.5s 2s forwards" text-anchor="middle" x="80" y="185">THE ROOM</text>
        <text fill="var(--rule)" font-family="monospace" font-size="5" letter-spacing="1.5" opacity="0" style="animation:erAppear 0.5s 2.3s forwards" text-anchor="middle" x="80" y="195">who is still here?</text>
      </svg>