<svg is:raw style="width:100%;font-family:'Inter',serif;" viewBox="0 0 640 260" xmlns="http://www.w3.org/2000/svg">

          <text fill="var(--muted)" font-size="10" font-style="italic" opacity="0.7" text-anchor="middle" x="320" y="16">This essay's own arc - six movements as monomyth</text>

          <!-- Horizontal arc line -->
          <path d="M40,180 C120,180 180,60 320,60 C460,60 520,180 600,180" fill="none" opacity="0.15" stroke="var(--ink)" stroke-width="0.8"></path>

          <!-- Movement markers along the arc -->

          <!-- I: The Collapse -->
          <circle cx="40" cy="180" fill="var(--muted)" opacity="0.5" r="5"></circle>
          <text fill="var(--ink)" font-size="8.5" font-weight="bold" text-anchor="middle" x="40" y="200">I</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="40" y="213">The Collapse</text>
          <text fill="var(--muted)" font-size="7" font-style="italic" text-anchor="middle" x="40" y="225">Ordinary world</text>
          <text fill="var(--muted)" font-size="7" font-style="italic" text-anchor="middle" x="40" y="236">named</text>

          <!-- II: The Field -->
          <circle cx="145" cy="130" fill="var(--muted)" opacity="0.5" r="5"></circle>
          <text fill="var(--ink)" font-size="8.5" font-weight="bold" text-anchor="middle" x="145" y="150">II</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="145" y="163">The Field</text>
          <text fill="var(--muted)" font-size="7" font-style="italic" text-anchor="middle" x="145" y="175">Threshold</text>
          <text fill="var(--muted)" font-size="7" font-style="italic" text-anchor="middle" x="145" y="186">crossed</text>

          <!-- III: The Ancestor -->
          <circle cx="240" cy="78" fill="var(--muted)" opacity="0.6" r="5"></circle>
          <text fill="var(--ink)" font-size="8.5" font-weight="bold" text-anchor="middle" x="240" y="60">III</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="240" y="48">The Ancestor</text>
          <text fill="var(--muted)" font-size="7" font-style="italic" text-anchor="middle" x="240" y="36">Road of trials</text>

          <!-- IV: The Architecture -->
          <circle cx="320" cy="60" fill="var(--accent)" opacity="0.5" r="7"></circle>
          <text fill="var(--accent)" font-size="8.5" font-weight="bold" text-anchor="middle" x="320" y="40">IV</text>
          <text fill="var(--accent)" font-size="7.5" opacity="0.8" text-anchor="middle" x="320" y="28">The Architecture</text>
          <text fill="var(--accent)" font-size="7" font-style="italic" opacity="0.6" text-anchor="middle" x="320" y="16">Innermost cave</text>

          <!-- V: The Danger -->
          <circle cx="400" cy="78" fill="var(--muted)" opacity="0.6" r="5"></circle>
          <text fill="var(--ink)" font-size="8.5" font-weight="bold" text-anchor="middle" x="400" y="60">V</text>
          <text fill="var(--muted)" font-size="7.5" text-anchor="middle" x="400" y="48">The Danger</text>
          <text fill="var(--muted)" font-size="7" font-style="italic" text-anchor="middle" x="400" y="36">The price paid</text>

          <!-- VI: The Return -->
          <circle cx="600" cy="180" fill="var(--accent)" opacity="0.8" r="7"></circle>
          <text fill="var(--accent)" font-size="8.5" font-weight="bold" text-anchor="middle" x="600" y="200">VI</text>
          <text fill="var(--accent)" font-size="7.5" opacity="0.8" text-anchor="middle" x="600" y="213">The Return</text>
          <text fill="var(--accent)" font-size="7" font-style="italic" opacity="0.6" text-anchor="middle" x="600" y="225">Elixir delivered</text>

          <!-- Fuji - permanent, in the background -->
          <polygon fill="none" opacity="0.08" points="460,175 490,120 520,175" stroke="var(--ink)" stroke-width="0.6"></polygon>
          <text fill="var(--muted)" font-size="7" font-style="italic" opacity="0.3" text-anchor="middle" x="490" y="195">Fuji</text>

        </svg>