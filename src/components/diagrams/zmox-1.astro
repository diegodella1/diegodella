<svg is:raw style="width:100%;font-family:'Inter',serif;" viewBox="0 0 640 220" xmlns="http://www.w3.org/2000/svg">
          <!-- Column 1: Infrastructure -->
          <rect fill="none" height="120" opacity="0.2" stroke="var(--ink)" stroke-width="0.8" width="180" x="20" y="40"></rect>
          <rect fill="var(--highlight)" height="120" opacity="0.5" width="180" x="20" y="40"></rect>
          <rect fill="var(--ink)" height="30" opacity="0.08" width="180" x="20" y="130"></rect>
          <text fill="var(--ink)" font-size="11" font-style="italic" opacity="0.5" text-anchor="middle" x="110" y="90">Pillar I</text>
          <text fill="var(--ink)" font-size="13" font-weight="bold" text-anchor="middle" x="110" y="108">Infrastructure</text>
          <text fill="var(--muted)" font-size="9" text-anchor="middle" x="110" y="150">Production &amp; Distribution</text>
          <!-- Strike through - lost -->
          <line opacity="0.6" stroke="var(--accent)" stroke-width="1.5" x1="30" x2="190" y1="108" y2="108"></line>

          <!-- Column 2: Legitimacy -->
          <rect fill="none" height="120" opacity="0.2" stroke="var(--ink)" stroke-width="0.8" width="180" x="230" y="40"></rect>
          <rect fill="var(--highlight)" height="120" opacity="0.5" width="180" x="230" y="40"></rect>
          <rect fill="var(--ink)" height="30" opacity="0.08" width="180" x="230" y="130"></rect>
          <text fill="var(--ink)" font-size="11" font-style="italic" opacity="0.5" text-anchor="middle" x="320" y="90">Pillar II</text>
          <text fill="var(--ink)" font-size="13" font-weight="bold" text-anchor="middle" x="320" y="108">Legitimacy</text>
          <text fill="var(--muted)" font-size="9" text-anchor="middle" x="320" y="150">Institutional Authority</text>
          <!-- Cracking -->
          <line opacity="0.35" stroke="var(--accent)" stroke-dasharray="4,3" stroke-width="1.5" x1="240" x2="400" y1="108" y2="108"></line>

          <!-- Column 3: Narrative -->
          <rect fill="none" height="120" opacity="0.5" stroke="var(--accent)" stroke-width="1.2" width="180" x="440" y="40"></rect>
          <rect fill="var(--accent-light)" height="120" opacity="0.6" width="180" x="440" y="40"></rect>
          <rect fill="var(--accent)" height="30" opacity="0.08" width="180" x="440" y="130"></rect>
          <text fill="var(--accent)" font-size="11" font-style="italic" opacity="0.7" text-anchor="middle" x="530" y="90">Pillar III</text>
          <text fill="var(--accent)" font-size="13" font-weight="bold" text-anchor="middle" x="530" y="108">Narrative</text>
          <text fill="var(--accent)" font-size="9" opacity="0.7" text-anchor="middle" x="530" y="150">The Rebuilable Pillar</text>

          <!-- Label bottom -->
          <text fill="var(--muted)" font-size="9" font-style="italic" text-anchor="middle" x="320" y="200">Dalio's three pillars of dominant order applied to media. I and II are lost. III is the only one that can be rebuilt.</text>
        </svg>