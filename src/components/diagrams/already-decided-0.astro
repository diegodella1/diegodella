<svg is:raw class="hero-svg" viewBox="0 0 160 200" xmlns="http://www.w3.org/2000/svg">
      <style is:inline>
        @keyframes adPulse{0%,100%{opacity:0.15}50%{opacity:0.6}}
        @keyframes adNodeOn{from{opacity:0;r:2}to{opacity:1;r:3.5}}
        @keyframes adCheck{from{stroke-dashoffset:12}to{stroke-dashoffset:0}}
        @keyframes adLine{from{stroke-dashoffset:80}to{stroke-dashoffset:0}}
        @keyframes adFade{from{opacity:0}to{opacity:1}}
      </style>
      <!-- Pi device -->
      <rect fill="none" height="60" rx="4" stroke="var(--ink)" stroke-width="1.2" width="50" x="55" y="70"></rect>
      <rect fill="none" height="36" rx="2" stroke="var(--rule)" stroke-width="0.6" width="36" x="62" y="78"></rect>
      <circle cx="80" cy="122" fill="var(--accent)" r="2" style="animation:adPulse 2s ease-in-out infinite"></circle>
      <!-- Radiating decision lines -->
      <line stroke="var(--rule)" stroke-dasharray="3 2" stroke-dashoffset="80" stroke-width="0.7" style="animation:adLine 1.5s 0.3s ease-out forwards" x1="55" x2="20" y1="85" y2="50"></line>
      <line stroke="var(--rule)" stroke-dasharray="3 2" stroke-dashoffset="80" stroke-width="0.7" style="animation:adLine 1.5s 0.5s ease-out forwards" x1="105" x2="140" y1="85" y2="50"></line>
      <line stroke="var(--rule)" stroke-dasharray="3 2" stroke-dashoffset="80" stroke-width="0.7" style="animation:adLine 1.5s 0.7s ease-out forwards" x1="80" x2="80" y1="70" y2="30"></line>
      <line stroke="var(--rule)" stroke-dasharray="3 2" stroke-dashoffset="80" stroke-width="0.7" style="animation:adLine 1.5s 0.9s ease-out forwards" x1="55" x2="20" y1="115" y2="150"></line>
      <line stroke="var(--rule)" stroke-dasharray="3 2" stroke-dashoffset="80" stroke-width="0.7" style="animation:adLine 1.5s 1.1s ease-out forwards" x1="105" x2="140" y1="115" y2="150"></line>
      <!-- Decision nodes -->
      <circle cx="20" cy="50" fill="var(--muted)" opacity="0" r="2" style="animation:adNodeOn 0.5s 1s forwards"></circle>
      <circle cx="140" cy="50" fill="var(--accent)" opacity="0" r="2" style="animation:adNodeOn 0.5s 1.2s forwards"></circle>
      <circle cx="80" cy="30" fill="var(--accent)" opacity="0" r="2" style="animation:adNodeOn 0.5s 1.4s forwards"></circle>
      <circle cx="20" cy="150" fill="var(--muted)" opacity="0" r="2" style="animation:adNodeOn 0.5s 1.6s forwards"></circle>
      <circle cx="140" cy="150" fill="var(--accent)" opacity="0" r="2" style="animation:adNodeOn 0.5s 1.8s forwards"></circle>
      <!-- Checkmarks on executed decisions -->
      <path d="M135 45 l3 4 l7-8" fill="none" stroke="var(--accent)" stroke-dasharray="12" stroke-dashoffset="12" stroke-width="1.5" style="animation:adCheck 0.4s 1.6s forwards"></path>
      <path d="M75 25 l3 4 l7-8" fill="none" stroke="var(--accent)" stroke-dasharray="12" stroke-dashoffset="12" stroke-width="1.5" style="animation:adCheck 0.4s 1.8s forwards"></path>
      <!-- Labels -->
      <text fill="var(--muted)" font-family="monospace" font-size="6" letter-spacing="2" opacity="0" style="animation:adFade 0.5s 2.2s forwards" text-anchor="middle" x="80" y="185">AUTONOMOUS</text>
      <text fill="var(--rule)" font-family="monospace" font-size="5" letter-spacing="1.5" opacity="0" style="animation:adFade 0.5s 2.5s forwards" text-anchor="middle" x="80" y="195">while you slept</text>
    </svg>