<svg is:raw style="width:100%;font-family:'Inter',serif;" viewBox="0 0 640 320" xmlns="http://www.w3.org/2000/svg">

          <!-- Circle -->
          <circle cx="320" cy="155" fill="none" opacity="0.15" r="95" stroke="var(--ink)" stroke-width="0.8"></circle>
          <circle cx="320" cy="155" fill="none" opacity="0.2" r="60" stroke="var(--accent)" stroke-dasharray="3,3" stroke-width="0.5"></circle>

          <!-- Center -->
          <circle cx="320" cy="155" fill="var(--accent)" opacity="0.15" r="10"></circle>
          <text fill="var(--accent)" font-size="7.5" opacity="0.7" text-anchor="middle" x="320" y="151">THE</text>
          <text fill="var(--accent)" font-size="7.5" opacity="0.7" text-anchor="middle" x="320" y="162">LENS</text>

          <!-- 8 positions around the circle -->
          <!-- 1: TOP - Ordinary World -->
          <circle cx="320" cy="57" fill="var(--muted)" opacity="0.5" r="4"></circle>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="middle" x="320" y="38">Ordinary World</text>
          <text fill="var(--muted)" font-size="8" font-style="italic" text-anchor="middle" x="320" y="50">User before the field</text>

          <!-- 2: TOP-RIGHT - Call -->
          <circle cx="387" cy="88" fill="var(--muted)" opacity="0.5" r="4"></circle>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="start" x="430" y="78">The Call</text>
          <text fill="var(--muted)" font-size="8" font-style="italic" text-anchor="start" x="430" y="90">First felt pull of the field</text>

          <!-- 3: RIGHT - Threshold -->
          <circle cx="415" cy="155" fill="var(--muted)" opacity="0.5" r="4"></circle>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="start" x="425" y="150">Threshold</text>
          <text fill="var(--muted)" font-size="8" font-style="italic" text-anchor="start" x="425" y="162">Casual → habitual return</text>

          <!-- 4: BOTTOM-RIGHT - Trials -->
          <circle cx="387" cy="222" fill="var(--muted)" opacity="0.5" r="4"></circle>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="start" x="425" y="216">Road of Trials</text>
          <text fill="var(--muted)" font-size="8" font-style="italic" text-anchor="start" x="425" y="228">Compound encounters over time</text>

          <!-- 5: BOTTOM - Cave -->
          <circle cx="320" cy="253" fill="var(--accent)" opacity="0.5" r="5"></circle>
          <text fill="var(--accent)" font-size="9" font-weight="bold" text-anchor="middle" x="320" y="272">Innermost Cave</text>
          <text fill="var(--accent)" font-size="8" font-style="italic" opacity="0.7" text-anchor="middle" x="320" y="284">Cognitive displacement</text>
          <text fill="var(--accent)" font-size="8" font-style="italic" opacity="0.7" text-anchor="middle" x="320" y="296">Old lens released</text>

          <!-- 6: BOTTOM-LEFT - Price -->
          <circle cx="253" cy="222" fill="var(--muted)" opacity="0.5" r="4"></circle>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="end" x="240" y="216">The Price</text>
          <text fill="var(--muted)" font-size="8" font-style="italic" text-anchor="end" x="240" y="228">Prior certainty surrendered</text>

          <!-- 7: LEFT - Return -->
          <circle cx="225" cy="155" fill="var(--muted)" opacity="0.5" r="4"></circle>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="end" x="215" y="150">Return</text>
          <text fill="var(--muted)" font-size="8" font-style="italic" text-anchor="end" x="215" y="162">Back to ordinary world</text>

          <!-- 8: TOP-LEFT - Changed -->
          <circle cx="253" cy="88" fill="var(--accent)" opacity="0.4" r="5"></circle>
          <text fill="var(--accent)" font-size="9" font-weight="bold" text-anchor="end" x="240" y="78">The Elixir</text>
          <text fill="var(--accent)" font-size="8" font-style="italic" opacity="0.7" text-anchor="end" x="240" y="90">A new lens. Shared forward.</text>

          <!-- Direction arrow -->
          <path d="M330,58 Q370,50 388,82" fill="none" marker-end="url(#arr2)" opacity="0.3" stroke="var(--muted)" stroke-dasharray="2,2" stroke-width="0.8"></path>

          <defs>
            <marker id="arr2" markerHeight="5" markerWidth="5" orient="auto" refX="2.5" refY="2.5">
              <path d="M0,0 L5,2.5 L0,5 Z" fill="var(--muted)" opacity="0.3"></path>
            </marker>
          </defs>

          <!-- Top label -->
          <text fill="var(--muted)" font-size="9" font-style="italic" opacity="0.5" text-anchor="middle" x="320" y="15">Campbell's Monomyth mapped to the Constitutive Arc</text>
        </svg>