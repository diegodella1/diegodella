<svg is:raw style="width:100%;font-family:'Inter',serif;" viewBox="0 0 640 250" xmlns="http://www.w3.org/2000/svg">
          <text fill="var(--muted)" font-size="10" font-style="italic" opacity="0.7" text-anchor="middle" x="320" y="16">Three falsifiable proxies - how to know if a field exists</text>

          <!-- Proxy 1 -->
          <rect fill="var(--highlight)" height="175" opacity="0.6" stroke="var(--ink)" stroke-width="0.5" width="195" x="10" y="28"></rect>
          <text fill="var(--muted)" font-size="9" font-style="italic" text-anchor="middle" x="107" y="48">Proxy I</text>
          <text fill="var(--ink)" font-size="10" font-weight="bold" text-anchor="middle" x="107" y="65">Lens Consistency</text>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="middle" x="107" y="77">Test</text>
          <line opacity="0.2" stroke="var(--ink)" stroke-width="0.3" x1="20" x2="195" y1="85" y2="85"></line>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="107" y="100">5 pieces, 5 surfaces,</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="107" y="112">same week. Ask 10</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="107" y="124">readers to identify</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="107" y="136">the point of view.</text>
          <line opacity="0.15" stroke="var(--ink)" stroke-width="0.3" x1="20" x2="195" y1="148" y2="148"></line>
          <text fill="var(--accent)" font-size="8" opacity="0.7" text-anchor="middle" x="107" y="163">&gt;70% agreement = field.</text>
          <text fill="var(--accent)" font-size="8" opacity="0.7" text-anchor="middle" x="107" y="175">&lt;40% = content op.</text>
          <text fill="var(--muted)" font-size="7" font-style="italic" text-anchor="middle" x="107" y="192">What it measures:</text>
          <text fill="var(--muted)" font-size="7" font-style="italic" text-anchor="middle" x="107" y="203">Coherence under variation</text>

          <!-- Proxy 2 -->
          <rect fill="var(--highlight)" height="175" opacity="0.6" stroke="var(--ink)" stroke-width="0.5" width="196" x="222" y="28"></rect>
          <text fill="var(--muted)" font-size="9" font-style="italic" text-anchor="middle" x="320" y="48">Proxy II</text>
          <text fill="var(--ink)" font-size="10" font-weight="bold" text-anchor="middle" x="320" y="65">Vocabulary</text>
          <text fill="var(--ink)" font-size="9" font-weight="bold" text-anchor="middle" x="320" y="77">Transfer Survey</text>
          <line opacity="0.2" stroke="var(--ink)" stroke-width="0.3" x1="232" x2="408" y1="85" y2="85"></line>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="320" y="100">Survey at 3, 6, 12</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="320" y="112">months: "Describe</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="320" y="124">how you think about</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="320" y="136">[domain] in your own</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="320" y="148">words." Code lens terms.</text>
          <line opacity="0.15" stroke="var(--ink)" stroke-width="0.3" x1="232" x2="408" y1="157" y2="157"></line>
          <text fill="var(--accent)" font-size="8" opacity="0.7" text-anchor="middle" x="320" y="171">Growth = lens transfer.</text>
          <text fill="var(--accent)" font-size="8" opacity="0.7" text-anchor="middle" x="320" y="183">Plateau = arc capture.</text>
          <text fill="var(--muted)" font-size="7" font-style="italic" text-anchor="middle" x="320" y="198">What it measures:</text>
          <text fill="var(--muted)" font-size="7" font-style="italic" text-anchor="middle" x="320" y="209">Transformation over time</text>

          <!-- Proxy 3 - starred -->
          <rect fill="var(--accent-light)" height="175" opacity="0.7" stroke="var(--accent)" stroke-width="1" width="195" x="435" y="28"></rect>
          <text fill="var(--accent)" font-size="9" font-style="italic" opacity="0.7" text-anchor="middle" x="532" y="48">Proxy III - Critical</text>
          <text fill="var(--accent)" font-size="10" font-weight="bold" text-anchor="middle" x="532" y="65">Independence</text>
          <text fill="var(--accent)" font-size="9" font-weight="bold" text-anchor="middle" x="532" y="77">Reasoning Test</text>
          <line opacity="0.3" stroke="var(--accent)" stroke-width="0.4" x1="445" x2="620" y1="85" y2="85"></line>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="532" y="100">Ask users to articulate</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="532" y="112">two positions that</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="532" y="124">disagree with the field,</text>
          <text fill="var(--muted)" font-size="8" text-anchor="middle" x="532" y="136">on a scale of 1–5.</text>
          <line opacity="0.2" stroke="var(--accent)" stroke-width="0.3" x1="445" x2="620" y1="148" y2="148"></line>
          <text fill="var(--accent)" font-size="8" opacity="0.8" text-anchor="middle" x="532" y="163">Cannot do it = capture.</text>
          <text fill="var(--accent)" font-size="8" opacity="0.8" text-anchor="middle" x="532" y="175">Does it = elixir.</text>
          <text fill="var(--accent)" font-size="7" font-style="italic" opacity="0.6" text-anchor="middle" x="532" y="192">What it measures:</text>
          <text fill="var(--accent)" font-size="7" font-style="italic" opacity="0.6" text-anchor="middle" x="532" y="203">Education vs. propaganda</text>

          <text fill="var(--muted)" font-size="8.5" font-style="italic" text-anchor="middle" x="320" y="237">An organization that cannot pass Proxy I does not have a field. One that fails Proxy III has crossed into capture.</text>
        </svg>