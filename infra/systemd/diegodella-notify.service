[Unit]
Description=DiegoDella contact notify service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/diego/Documents/diegodella/services/notify
ExecStart=/home/diego/Documents/diegodella/services/notify/venv/bin/python /home/diego/Documents/diegodella/services/notify/app.py
Restart=always
RestartSec=5
User=diego
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
